# Copy to .env for local dev. Set the real values in the Netlify dashboard
# (Site settings -> Environment variables). Never commit real keys.

# Supabase — single source of truth for businesses, claims, subscribers, admins
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase public pair for client-side login (magic link). Safe to expose;
# these are baked into the browser at build time. Same values as the URL and
# anon key above, but PUBLIC_-prefixed so Astro ships them to the client.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Google Places API (New) — ratings, reviews, phone, website, live open/closed
# Restrict this key to the Places API and to the site referrers / functions.
GOOGLE_MAPS_API_KEY=

# Resend — verification and notification emails
RESEND_API_KEY=
EMAIL_FROM=

# Netlify build hook — admin "rebuild" button + on-data-change rebuilds
NETLIFY_BUILD_HOOK_URL=

# Admin access — comma-separated allowlist, or use a Supabase admin role
ADMIN_ALLOWED_EMAILS=

# Cloudflare Turnstile (anti-bot on public forms). Site key is public (baked
# into the client); secret key is used by the submit-company function and by
# Supabase Auth (paste the secret into Supabase Auth CAPTCHA settings too).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Zapier Catch Hook URL. Each company submission is POSTed here so a Zap can
# send email + SMS notifications. Leave blank to disable.
ZAPIER_WEBHOOK_URL=

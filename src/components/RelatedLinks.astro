---
// A labeled group of internal links (nearby cities, related trades, etc.).
// Renders nothing when there are no links, so callers can pass an empty list.
import type { SeoLink } from "../lib/links";
interface Props {
  title: string;
  links: SeoLink[];
}
const { title, links } = Astro.props;
---

{
  links.length > 0 && (
    <nav aria-label={title} class="mx-auto max-w-7xl px-4 pb-10">
      <h2 class="text-xl font-bold text-brand-blue">{title}</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="tap-target inline-flex items-center rounded-lg border border-brand-blue px-4 py-1 text-base text-brand-blue hover:bg-brand-blue hover:text-white"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

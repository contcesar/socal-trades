---
import type { Business, Trade } from "../lib/types";

interface Props {
  business: Business;
  trade?: Trade;
}
const { business, trade } = Astro.props;
---

<article
  class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm hover:shadow-md focus-within:shadow-md"
>
  <h3 class="text-xl font-bold leading-snug">
    <a
      href={`/business/${business.slug}`}
      class="text-brand-blue hover:underline"
    >
      {business.name}
    </a>
  </h3>

  <p class="mt-1 text-base text-gray-600">
    {trade ? trade.name : business.trade} &middot; {business.city}, {
      business.county
    } County
  </p>

  <p class="mt-3 text-lg text-gray-800">{business.short_description}</p>

  {/* Live rating fills in on the profile page (Phase 2). Kept off cards to
      avoid a Places call per card. */}
  <div class="mt-4 flex flex-wrap gap-3">
    {
      business.phone && (
        <a
          href={`tel:${business.phone}`}
          class="tap-target inline-flex items-center rounded-lg bg-brand-blue px-4 text-base font-semibold text-white hover:opacity-90"
        >
          Call
        </a>
      )
    }
    <a
      href={`/business/${business.slug}`}
      class="tap-target inline-flex items-center rounded-lg border-2 border-brand-blue px-4 text-base font-semibold text-brand-blue hover:bg-brand-blue hover:text-white"
    >
      View profile
    </a>
  </div>
</article>

---
import type { Business, Trade } from "../lib/types";
import TradeIcon from "./TradeIcon.astro";
import BookmarkButton from "./BookmarkButton.astro";
import RatingBadge from "./RatingBadge.astro";

interface Props {
  business: Business;
  trade?: Trade;
}
const { business, trade } = Astro.props;
const photo = business.photo_urls[0] ?? null;
const featured = business.featured === true;
---

<article class={`group${featured ? " rounded-2xl border-2 p-2" : ""}`} style={featured ? "border-color:#F59E0B" : undefined}>
  <div class="relative">
    <a
      href={`/business/${business.slug}`}
      class="relative block aspect-[4/3] overflow-hidden rounded-2xl bg-brand-cream"
    >
      {
        featured && (
          <span class="pointer-events-none absolute left-0 top-0 z-10" aria-hidden="true">
            <svg width="60" height="60" viewBox="0 0 60 60">
              <path d="M0 0H60L0 60Z" fill="#F59E0B" />
              <g transform="translate(6 6) scale(0.8)" fill="#12417F">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2z" />
              </g>
            </svg>
          </span>
        )
      }
      {
        photo ? (
          <>
            <img
              src={photo}
              alt={business.name}
              loading="lazy"
              class="h-full w-full object-cover transition group-hover:scale-[1.03]"
            />
            <span class="pointer-events-none absolute inset-0 bg-brand-blue/25 transition-opacity duration-300 group-hover:opacity-0" />
          </>
        ) : (
          <span class="flex h-full w-full flex-col items-center justify-center gap-2 text-brand-blue">
            <TradeIcon icon={trade?.icon ?? "wrench"} class="h-14 w-14" />
            <span class="text-base font-semibold">{trade?.name ?? ""}</span>
          </span>
        )
      }
    </a>
    <BookmarkButton slug={business.slug} class="absolute right-3 top-3" />
  </div>

  <a href={`/business/${business.slug}`} class="mt-3 block">
    <h3 class="block break-words text-sm sm:text-lg font-bold leading-snug text-gray-900">
      {business.name}
    </h3>
    <div class="mt-1 flex items-center justify-between gap-2">
      <p class="flex min-w-0 items-center gap-1 text-xs sm:text-base font-semibold text-brand-blue">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 sm:h-4 sm:w-4 shrink-0" aria-hidden="true"><path d="M12 21s-6-5.686-6-10a6 6 0 1 1 12 0c0 4.314-6 10-6 10z"></path><circle cx="12" cy="11" r="2.5"></circle></svg>
        <span class="min-w-0 truncate">{business.city}</span>
      </p>
      <RatingBadge rating={business.rating} count={business.review_count} class="shrink-0 text-xs sm:text-sm" />
    </div>
    <p class="mt-1 text-xs sm:text-base text-gray-600">
      {trade ? trade.name : business.trade} &middot; {business.county} County
    </p>
    <p class="mt-1 hidden text-gray-700 sm:line-clamp-2 sm:text-sm">
      {business.short_description}
    </p>
  </a>
</article>

---
const year = new Date().getFullYear();
---

<footer class="bg-brand-blue text-brand-cream mt-16">
  <div class="mx-auto max-w-3xl px-4 py-10 flex flex-col items-center gap-6 text-center">
    <a href="/" aria-label="SoCal Trades home">
      <img src="/socal-trades-white.png" alt="SoCal Trades" class="h-16 w-auto" />
    </a>

    <nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-lg">
      <a href="/list-your-company" class="underline hover:no-underline">List your company</a>
      <a href="/saved" class="underline hover:no-underline">Saved</a>
      <a href="/about" class="underline hover:no-underline">About</a>
      <a href="/contact" class="underline hover:no-underline">Contact</a>
      <a href="/privacy" class="underline hover:no-underline">Privacy</a>
      <a href="/terms" class="underline hover:no-underline">Terms</a>
    </nav>

    <p class="text-base opacity-90">
      &copy; {year} SoCal Trades. A directory of trades companies in Southern
      California.
    </p>
  </div>
</footer>

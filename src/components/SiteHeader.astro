---
// Sticky white header, Airbnb-style: logo left, centered pill search (blank
// with a red search button), "List Your Company" CTA + menu on the right.
// Submitting navigates to /search, which is crawlable and enhanced with Fuse.js.
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200">
  <div class="mx-auto max-w-7xl px-4 py-3">
    <div class="flex items-center justify-between gap-4 sm:grid sm:grid-cols-[1fr_minmax(0,36rem)_1fr]">
      <a href="/" class="shrink-0 sm:justify-self-start" aria-label="SoCal Trades home">
        <img src="/socal-trades.png" alt="SoCal Trades" class="h-12 w-auto max-w-none shrink-0 sm:h-14" />
      </a>

      {/* Desktop search, centered in the bar. */}
      <form
        class="hidden sm:flex sm:w-full items-center rounded-full border border-gray-300 bg-white py-1 pl-5 pr-1 shadow-sm focus-within:border-brand-blue focus-within:shadow-md"
        role="search"
        aria-label="Search trades companies"
        action="/search"
        method="get"
      >
        <input
          type="search"
          name="q"
          placeholder="I'm looking for..."
          aria-label="Search companies, trades, or cities"
          autocomplete="off"
          class="site-search-input min-w-0 flex-1 bg-transparent text-lg text-gray-900 outline-none placeholder:text-gray-500"
        />
        <button
          type="submit"
          aria-label="Search"
          class="tap-target flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#E2E8EE] text-brand-blue hover:bg-[#d3dce7]"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" class="h-5 w-5" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        </button>
      </form>

      <div class="flex shrink-0 items-center gap-2 sm:justify-self-end">
        <a
          id="cta-listcompany"
          href="/list-your-company"
          class="tap-target hidden items-center rounded-full px-4 text-base font-semibold text-brand-blue hover:bg-gray-100 sm:inline-flex"
        >
          List Your Company
        </a>

        <details class="relative">
          <summary
            class="tap-target flex cursor-pointer list-none items-center gap-2 rounded-full border border-gray-300 px-3 hover:shadow-md"
            aria-label="Menu"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5 text-gray-700" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
            <svg id="menu-avatar" viewBox="0 0 24 24" fill="currentColor" class="hidden h-7 w-7 text-gray-500" aria-hidden="true" hidden><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4 0-9 2-9 6v0h18v0c0-4-5-6-9-6z"></path></svg>
          </summary>
          <nav
            class="absolute right-0 mt-2 w-56 rounded-xl border border-gray-200 bg-white py-2 text-lg shadow-lg"
            aria-label="Main menu"
          >
            <a id="menu-signup" href="/signup" class="block px-4 py-2 font-semibold hover:bg-gray-100">Sign up</a>
            <a id="menu-login" href="/login" class="block px-4 py-2 hover:bg-gray-100">Log in</a>
            <a id="menu-account" href="/account" class="hidden px-4 py-2 font-semibold hover:bg-gray-100" hidden>Account</a>
            <hr class="my-2 border-gray-200" />
            <a href="/saved" class="block px-4 py-2 hover:bg-gray-100">Saved companies</a>
            <a id="menu-listcompany" href="/list-your-company" class="block px-4 py-2 hover:bg-gray-100">List your company</a>
            <a id="menu-logout" href="/logout" class="hidden px-4 py-2 hover:bg-gray-100" hidden>Log out</a>
            <hr class="my-2 border-gray-200" />
            <a href="/about" class="block px-4 py-2 hover:bg-gray-100">About</a>
            <a href="/contact" class="block px-4 py-2 hover:bg-gray-100">Contact</a>
          </nav>
        </details>
      </div>
    </div>

    {/* Mobile search drops below the bar and spans full width. */}
    <form
      class="mt-3 flex items-center rounded-full border border-gray-300 bg-white py-1 pl-5 pr-1 shadow-sm focus-within:border-brand-blue focus-within:shadow-md sm:hidden"
      role="search"
      aria-label="Search trades companies"
      action="/search"
      method="get"
    >
      <input
        type="search"
        name="q"
        placeholder="I'm looking for..."
        aria-label="Search companies, trades, or cities"
        autocomplete="off"
        class="site-search-input min-w-0 flex-1 bg-transparent text-lg text-gray-900 outline-none placeholder:text-gray-500"
      />
      <button
        type="submit"
        aria-label="Search"
        class="tap-target flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#E2E8EE] text-brand-blue hover:bg-[#d3dce7]"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" class="h-5 w-5" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </button>
    </form>
  </div>
</header>

<script>
  // Light-weight login state for the menu. Reads the flag set by the auth
  // pages, so the header never loads the auth SDK on directory pages.
  function show(id: string) {
    const el = document.getElementById(id);
    el?.removeAttribute("hidden");
    el?.classList.remove("hidden");
  }
  function hide(id: string) {
    document.getElementById(id)?.setAttribute("hidden", "");
  }
  try {
    if (localStorage.getItem("st_auth_email")) {
      // Show the avatar only for signed-in visitors.
      show("menu-avatar");
      hide("menu-login");
      hide("menu-signup");
      show("menu-account");
      show("menu-logout");

      // If they already have a company listed, relabel the CTA + menu item.
      if (localStorage.getItem("st_company")) {
        const cta = document.getElementById("cta-listcompany");
        const item = document.getElementById("menu-listcompany");
        if (cta) {
          cta.textContent = "Your Company";
          cta.setAttribute("href", "/account");
        }
        if (item) {
          item.textContent = "Your company";
          item.setAttribute("href", "/account");
        }
      }
    }
  } catch {
    /* storage blocked; show the logged-out menu */
  }

  // Close the menu dropdown after a selection. Clicking a link navigates to a
  // fresh page (naturally closed), but the browser's back/forward cache can
  // restore the open state, so close it on show too.
  const menu = document.querySelector<HTMLDetailsElement>("header details");
  menu?.addEventListener("click", (e) => {
    if ((e.target as Element)?.closest("a")) menu.open = false;
  });
  window.addEventListener("pageshow", () => {
    if (menu) menu.open = false;
  });
</script>

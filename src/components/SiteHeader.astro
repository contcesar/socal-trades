---
// Sticky, centered search bar on every page.
// Phase 0: visual placeholder. Wired to client-side Fuse.js search in Phase 1.
---

<header class="sticky top-0 z-50 bg-brand-blue shadow-md">
  <div class="mx-auto max-w-3xl px-4 py-3 flex flex-col items-center gap-3">
    <a href="/" class="text-brand-cream text-2xl font-bold tracking-tight">
      SoCal Trades
    </a>
    <form class="w-full" role="search" aria-label="Search trades companies">
      <label for="site-search" class="sr-only">Search trades and cities</label>
      <input
        id="site-search"
        type="search"
        name="q"
        placeholder="Search a trade or city…"
        autocomplete="off"
        class="tap-target w-full rounded-lg border-2 border-transparent bg-white px-4 text-lg text-gray-900 placeholder:text-gray-500 focus:border-brand-red"
      />
    </form>
  </div>
</header>

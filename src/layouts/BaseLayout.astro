---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Find trades companies across Southern California. Plumbers, electricians, HVAC, roofers and more, with ratings and reviews.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/socal-trades.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot name="header" />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <slot name="footer" />

    <script>
      // Site-wide bookmarks, stored per-visitor in localStorage. Any element
      // with class "bookmark-btn" and a data-slug toggles here via delegation,
      // so it works on cards rendered at build time and by the search script.
      const KEY = "st_bookmarks";
      const read = (): Set<string> => {
        try {
          return new Set(JSON.parse(localStorage.getItem(KEY) || "[]"));
        } catch {
          return new Set();
        }
      };
      const write = (s: Set<string>) => {
        try {
          localStorage.setItem(KEY, JSON.stringify([...s]));
        } catch {
          /* storage blocked; bookmarks are best-effort */
        }
      };
      const paint = (btn: Element, on: boolean) =>
        btn.setAttribute("aria-pressed", on ? "true" : "false");

      const sync = () => {
        const s = read();
        document.querySelectorAll<HTMLElement>(".bookmark-btn").forEach((b) => {
          if (b.dataset.slug) paint(b, s.has(b.dataset.slug));
        });
      };

      document.addEventListener("click", (e) => {
        const btn = (e.target as Element)?.closest?.(".bookmark-btn") as
          | HTMLElement
          | null;
        if (!btn || !btn.dataset.slug) return;
        e.preventDefault();
        e.stopPropagation();
        const s = read();
        const slug = btn.dataset.slug;
        if (s.has(slug)) s.delete(slug);
        else s.add(slug);
        write(s);
        paint(btn, s.has(slug));
        document.dispatchEvent(new CustomEvent("bookmarks:changed"));
      });

      // Re-sync after the search script (or any script) injects new cards.
      document.addEventListener("cards:rendered", sync);
      sync();
    </script>
  </body>
</html>

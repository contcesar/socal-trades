---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BusinessCard from "../components/BusinessCard.astro";
import { getPublishedBusinesses, getTrades, getTradeMap } from "../lib/data";

const businesses = await getPublishedBusinesses();
const trades = await getTrades();
const tradeMap = await getTradeMap();

const cities = [...new Set(businesses.map((b) => b.city))].sort((a, b) =>
  a.localeCompare(b),
);

const title = "Search trades companies | SoCal Trades";
const description =
  "Search trades companies across Southern California by trade and city.";
---

<BaseLayout title={title} description={description}>
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-7xl px-4 py-8">
    <h1 class="text-3xl font-bold text-brand-blue">Search results</h1>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <div class="flex-1">
        <label for="filter-trade" class="sr-only">Filter by trade</label>
        <select
          id="filter-trade"
          class="tap-target w-full rounded-lg border-2 border-gray-300 bg-white px-3 text-lg text-gray-900"
        >
          <option value="">All trades</option>
          {trades.map((t) => <option value={t.slug}>{t.name}</option>)}
        </select>
      </div>
      <div class="flex-1">
        <label for="filter-city" class="sr-only">Filter by city</label>
        <select
          id="filter-city"
          class="tap-target w-full rounded-lg border-2 border-gray-300 bg-white px-3 text-lg text-gray-900"
        >
          <option value="">All cities</option>
          {cities.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>
    </div>

    <p id="result-count" class="mt-6 text-lg text-gray-700" aria-live="polite">
      {businesses.length} companies
    </p>

    <div
      id="results"
      class="mt-4 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4"
    >
      {businesses.map((b) => <BusinessCard business={b} trade={tradeMap.get(b.trade)} />)}
    </div>

    <p id="no-results" class="mt-4 hidden text-lg text-gray-700">
      No companies match your search. Try a different trade or city.
    </p>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import Fuse from "fuse.js";

  interface IndexItem {
    id: string;
    name: string;
    slug: string;
    trade: string;
    tradeName: string;
    secondaryTradeNames: string[];
    city: string;
    citySlug: string;
    county: string;
    countySlug: string;
    serviceAreas: string[];
    keywords: string[];
    shortDescription: string;
    rating: number | null;
    reviewCount: number | null;
  }

  const resultsEl = document.getElementById("results")!;
  const countEl = document.getElementById("result-count")!;
  const noResultsEl = document.getElementById("no-results")!;
  const tradeSel = document.getElementById("filter-trade") as HTMLSelectElement;
  const citySel = document.getElementById("filter-city") as HTMLSelectElement;
  const searchInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>(".site-search-input"),
  );

  const escapeHtml = (s: string): string =>
    s.replace(
      /[&<>"']/g,
      (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[
          c
        ]!,
    );

  function card(item: IndexItem): string {
    return `
      <article class="group">
        <div class="relative">
          <a href="/business/${item.slug}" class="block aspect-[4/3] overflow-hidden rounded-2xl bg-brand-cream">
            <span class="flex h-full w-full items-center justify-center px-3 text-center text-base font-semibold text-brand-blue">${escapeHtml(item.tradeName)}</span>
          </a>
          <button type="button" class="bookmark-btn tap-target absolute right-3 top-3 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/90 text-brand-blue shadow-md hover:bg-white" data-slug="${item.slug}" aria-pressed="false" aria-label="Save company" title="Save company">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"></path></svg>
          </button>
        </div>
        <a href="/business/${item.slug}" class="mt-3 block">
          <div class="flex items-start justify-between gap-2">
            <h3 class="text-lg font-bold leading-snug text-gray-900">${escapeHtml(item.name)}</h3>
            ${item.rating != null ? `<span class="mt-0.5 inline-flex shrink-0 items-center gap-1 text-base"><span class="text-amber-500">★</span><span class="font-semibold text-gray-900">${item.rating.toFixed(1)}</span>${item.reviewCount ? `<span class="text-gray-500">(${item.reviewCount})</span>` : ""}</span>` : ""}
          </div>
          <p class="mt-0.5 text-base text-gray-600">${escapeHtml(item.tradeName)} &middot; ${escapeHtml(item.city)}, ${escapeHtml(item.county)} County</p>
          <p class="mt-1 line-clamp-2 text-base text-gray-700">${escapeHtml(item.shortDescription)}</p>
        </a>
      </article>`;
  }

  function render(items: IndexItem[]): void {
    resultsEl.innerHTML = items.map(card).join("");
    countEl.textContent = `${items.length} ${items.length === 1 ? "company" : "companies"}`;
    noResultsEl.classList.toggle("hidden", items.length !== 0);
    // Let the site-wide bookmark script paint the new buttons.
    document.dispatchEvent(new CustomEvent("cards:rendered"));
  }

  async function init(): Promise<void> {
    let data: IndexItem[] = [];
    try {
      const res = await fetch("/businesses.json");
      data = await res.json();
    } catch {
      return; // keep the server-rendered list
    }

    const fuse = new Fuse(data, {
      threshold: 0.4,
      ignoreLocation: true,
      keys: [
        { name: "name", weight: 3 },
        { name: "keywords", weight: 3 },
        { name: "tradeName", weight: 2 },
        { name: "secondaryTradeNames", weight: 1 },
        { name: "city", weight: 2 },
        { name: "county", weight: 1 },
        { name: "serviceAreas", weight: 1 },
        { name: "shortDescription", weight: 1 },
      ],
    });

    const params = new URLSearchParams(location.search);
    const q0 = params.get("q") ?? "";
    const trade0 = params.get("trade") ?? "";
    const city0 = params.get("city") ?? "";
    searchInputs.forEach((i) => (i.value = q0));
    if (trade0) tradeSel.value = trade0;
    if (city0) citySel.value = city0;

    function currentQuery(): string {
      const withValue = searchInputs.find((i) => i.value.trim() !== "");
      return (withValue?.value ?? searchInputs[0]?.value ?? "").trim();
    }

    function apply(): void {
      const q = currentQuery();
      searchInputs.forEach((i) => {
        if (i.value !== q) i.value = q;
      });
      const trade = tradeSel.value;
      const city = citySel.value;

      let items = q ? fuse.search(q).map((r) => r.item) : data.slice();
      if (trade) items = items.filter((i) => i.trade === trade);
      if (city) items = items.filter((i) => i.city === city);

      render(items);

      const next = new URLSearchParams();
      if (q) next.set("q", q);
      if (trade) next.set("trade", trade);
      if (city) next.set("city", city);
      const qs = next.toString();
      history.replaceState(null, "", qs ? `/search?${qs}` : "/search");
    }

    tradeSel.addEventListener("change", apply);
    citySel.addEventListener("change", apply);
    searchInputs.forEach((i) => i.addEventListener("input", apply));

    if (q0 || trade0 || city0) apply();
  }

  init();
</script>

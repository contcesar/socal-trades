---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout title="Signing out… | SoCal Trades" description="Signing you out.">
  <SiteHeader slot="header" />
  <section class="mx-auto max-w-md px-4 py-16 text-center">
    <h1 class="text-2xl font-bold text-brand-blue">Signing you out…</h1>
    <p class="mt-3 text-lg text-gray-700">One moment.</p>
  </section>
  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { getSupabase, setAuthFlag } from "../lib/supabaseClient";

  async function run(): Promise<void> {
    try {
      await getSupabase()?.auth.signOut();
    } catch {
      /* sign out is best-effort */
    }
    setAuthFlag(null);
    try {
      localStorage.removeItem("st_company");
      localStorage.removeItem("st_admin");
    } catch {
      /* ignore */
    }
    location.replace("/");
  }
  run();
</script>

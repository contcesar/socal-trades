---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Turnstile from "../components/Turnstile.astro";
---

<BaseLayout
  title="Contact | SoCal Trades"
  description="Get in touch with SoCal Trades."
>
  <SiteHeader slot="header" />
  <section class="mx-auto max-w-xl px-4 py-10">
    <h1 class="text-3xl font-bold text-brand-blue">Contact us</h1>
    <p class="mt-3 text-lg text-gray-800">
      Questions, a listing to add, or a trade we're missing? Send us a note and
      we'll get back to you.
    </p>

    <form id="contact-form" class="mt-8 flex flex-col gap-5" novalidate>
      <div class="flex flex-col gap-1">
        <label class="text-lg font-semibold text-gray-800" for="c-name">Name*</label>
        <input id="c-name" name="name" type="text" required autocomplete="name"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue" />
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-lg font-semibold text-gray-800" for="c-phone">Phone number*</label>
        <input id="c-phone" name="phone" type="tel" required autocomplete="tel"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue" />
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-lg font-semibold text-gray-800" for="c-email">Email*</label>
        <input id="c-email" name="email" type="email" required autocomplete="email"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue" />
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-lg font-semibold text-gray-800" for="c-message">How can we help?</label>
        <textarea id="c-message" name="message" rows="5"
          class="rounded-lg border-2 border-gray-300 bg-white px-4 py-2 text-lg text-gray-900 focus:border-brand-blue"></textarea>
      </div>

      <Turnstile />

      <p id="contact-error" class="hidden text-lg font-semibold text-brand-red-dark" role="alert"></p>

      <button id="contact-btn" type="submit"
        class="tap-target rounded-lg bg-brand-blue px-6 text-lg font-semibold text-white hover:opacity-90">
        Send message
      </button>
    </form>

    <div id="contact-success" class="mt-8 hidden rounded-xl border border-gray-200 bg-white p-6" hidden>
      <h2 class="text-2xl font-bold text-brand-blue">Thanks for reaching out</h2>
      <p class="mt-3 text-lg text-gray-800">
        We got your message and will get back to you soon.
      </p>
    </div>
  </section>
  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const errorEl = document.getElementById("contact-error")!;
  const successEl = document.getElementById("contact-success")!;
  const btn = document.getElementById("contact-btn") as HTMLButtonElement;

  function showError(msg: string): void {
    errorEl.textContent = msg;
    errorEl.classList.remove("hidden");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    const data = Object.fromEntries(new FormData(form).entries());
    if (!data.name || !data.phone || !data.email) {
      showError("Please fill in your name, phone number, and email.");
      return;
    }
    btn.disabled = true;
    btn.textContent = "Sending…";
    try {
      const res = await fetch("/.netlify/functions/submit-contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        btn.disabled = false;
        btn.textContent = "Send message";
        showError(body.error || "Sorry, something went wrong. Please try again.");
        return;
      }
      form.hidden = true;
      successEl.hidden = false;
      successEl.classList.remove("hidden");
      successEl.scrollIntoView({ behavior: "smooth", block: "center" });
    } catch {
      btn.disabled = false;
      btn.textContent = "Send message";
      showError("Sorry, something went wrong. Please try again in a moment.");
    }
  });
</script>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TradeIcon from "../components/TradeIcon.astro";
import CompanyCarousel from "../components/CompanyCarousel.astro";
import { getTrades, getFeaturedBusinesses, getTradeMap } from "../lib/data";
import { organizationSchema, websiteSchema, graph } from "../lib/schema";

const trades = await getTrades();
const featured = await getFeaturedBusinesses(8);
const tradeMap = await getTradeMap();
const jsonLd = graph([organizationSchema(), websiteSchema()]);
---

<BaseLayout
  title="SoCal Trades | Find trades companies in Southern California"
  description="SoCal Trades helps you find trusted trades companies across Southern California, from plumbers and electricians to roofers, HVAC and more."
>
  <SiteHeader slot="header" />

  {
    featured.length > 0 && (
      <CompanyCarousel
        heading="Explore Top Rated Local Trades in Southern California"
        headingShort="Top Rated Trades in SoCal"
        href="/search"
        businesses={featured}
        tradeMap={tradeMap}
      />
    )
  }

  <section aria-labelledby="cat-heading" class="mx-auto max-w-7xl px-4 py-8">
    <h2 id="cat-heading" class="text-2xl font-bold text-brand-blue">
      Browse by trade
    </h2>
    <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {
        trades.map((trade) => (
          <li>
            <a
              href={`/trades/${trade.slug}`}
              class="tap-target flex h-full flex-col items-center justify-center gap-2 rounded-xl border-2 border-brand-blue bg-white p-5 text-center text-lg font-semibold text-brand-blue hover:bg-brand-blue hover:text-white"
            >
              <TradeIcon icon={trade.icon} class="h-9 w-9" />
              <span>{trade.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-lg text-gray-700">
      Don't find a trade?{" "}
      <a href="/contact" class="inline-flex items-center gap-1 font-semibold text-brand-blue underline hover:no-underline">
        Let us know
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </p>
  </section>

  <script type="application/ld+json" is:inline set:html={jsonLd} />

  <SiteFooter slot="footer" />
</BaseLayout>

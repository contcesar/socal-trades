---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TradeIcon from "../components/TradeIcon.astro";
import { getTrades } from "../lib/data";

const trades = await getTrades();
---

<BaseLayout title="SoCal Trades — Find trades companies in Southern California">
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-4xl px-4 py-10 text-center">
    <h1 class="text-3xl sm:text-4xl font-bold text-brand-blue">
      Find trusted trades companies in Southern California
    </h1>
    <p class="mt-4 text-lg text-gray-700">
      Plumbers, electricians, roofers and more. Pick a trade or search by city.
    </p>
  </section>

  <section aria-labelledby="cat-heading" class="mx-auto max-w-4xl px-4 pb-16">
    <h2 id="cat-heading" class="sr-only">Trade categories</h2>
    <ul class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      {
        trades.map((trade) => (
          <li>
            <a
              href={`/trades/${trade.slug}`}
              class="tap-target flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-brand-blue bg-white p-5 text-center text-lg font-semibold text-brand-blue hover:bg-brand-blue hover:text-white"
            >
              <TradeIcon icon={trade.icon} class="h-9 w-9" />
              <span>{trade.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

// Phase 0 placeholder tiles. Real categories come from Supabase in Phase 1.
const sampleTrades = [
  "Plumbing",
  "Electrical",
  "HVAC",
  "Roofing",
  "General Contractor",
  "Landscaping",
];
---

<BaseLayout title="SoCal Trades — Find trades companies in Southern California">
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-3xl px-4 py-10 text-center">
    <h1 class="text-3xl sm:text-4xl font-bold text-brand-blue">
      Find trusted trades companies in Southern California
    </h1>
    <p class="mt-4 text-lg text-gray-700">
      Plumbers, electricians, roofers and more. Search by trade or city.
    </p>
  </section>

  <section aria-labelledby="cat-heading" class="mx-auto max-w-3xl px-4 pb-10">
    <h2 id="cat-heading" class="sr-only">Trade categories</h2>
    <ul class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      {
        sampleTrades.map((trade) => (
          <li>
            <a
              href="/"
              class="tap-target flex items-center justify-center rounded-xl border-2 border-brand-blue bg-white p-6 text-center text-lg font-semibold text-brand-blue hover:bg-brand-blue hover:text-white"
            >
              {trade}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-center text-base text-gray-600">
      Phase 0 preview. Categories and listings load from the database in Phase 1.
    </p>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

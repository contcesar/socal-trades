---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TradeIcon from "../components/TradeIcon.astro";
import CompanyCarousel from "../components/CompanyCarousel.astro";
import { getTrades, getFeaturedBusinesses, getTradeMap } from "../lib/data";

const trades = await getTrades();
const featured = await getFeaturedBusinesses(8);
const tradeMap = await getTradeMap();
---

<BaseLayout title="SoCal Trades — Find trades companies in Southern California">
  <SiteHeader slot="header" />

  {
    featured.length > 0 && (
      <CompanyCarousel
        heading="Popular companies in Southern California"
        href="/search"
        businesses={featured}
        tradeMap={tradeMap}
      />
    )
  }

  <section aria-labelledby="cat-heading" class="mx-auto max-w-7xl px-4 py-8">
    <h2 id="cat-heading" class="text-2xl font-bold text-gray-900">
      Browse by trade
    </h2>
    <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {
        trades.map((trade) => (
          <li>
            <a
              href={`/trades/${trade.slug}`}
              class="tap-target flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-brand-blue bg-white p-5 text-center text-lg font-semibold text-brand-blue hover:bg-brand-blue hover:text-white"
            >
              <TradeIcon icon={trade.icon} class="h-9 w-9" />
              <span>{trade.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

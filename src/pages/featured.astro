---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Turnstile from "../components/Turnstile.astro";

const PHONE_DISPLAY = "(909) 698-9227";
const PHONE_TEL = "+19096989227";
---

<BaseLayout
  title="Get Featured on SoCal Trades | SoCal Trades"
  description="Feature your company at the top of SoCal Trades. A weekly or monthly advertising spot for vetted Southern California contractors."
>
  <SiteHeader slot="header" />
  <section class="mx-auto max-w-2xl px-4 py-10">
    <h1 class="text-3xl sm:text-4xl font-bold text-brand-blue">
      Feature your company on SoCal Trades
    </h1>
    <p class="mt-4 text-lg text-gray-800">
      Featured companies sit at the very top of SoCal Trades with a highlighted
      card, so more customers see you first. It's a simple advertising spot you
      can book weekly or monthly.
    </p>
    <p class="mt-3 text-lg text-gray-800">
      Every company on SoCal Trades is a highly vetted, quality contractor in
      Southern California. Featuring puts your business ahead of that trusted
      group where homeowners start their search.
    </p>

    <div class="mt-6 rounded-xl border border-brand-blue/40 bg-white p-5">
      <h2 class="text-xl font-bold text-brand-blue">How it works</h2>
      <ul class="mt-3 space-y-2 text-lg text-gray-800">
        <li>Up to four companies are featured at a time.</li>
        <li>Book a <strong>weekly</strong> or <strong>monthly</strong> spot.</li>
        <li>Your featured card links straight to your profile.</li>
      </ul>
      <p class="mt-4 text-lg text-gray-800">
        Want details? Call SoCal Trades at{" "}
        <a href={`tel:${PHONE_TEL}`} class="font-semibold text-brand-blue underline">
          {PHONE_DISPLAY}
        </a>, or send the form below and we'll reach out.
      </p>
    </div>

    <form id="feat-form" class="mt-8 flex flex-col gap-5" novalidate>
      <div class="flex flex-col gap-1">
        <label class="text-lg font-semibold text-gray-800" for="f-name">Name*</label>
        <input id="f-name" name="name" type="text" required autocomplete="name"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue" />
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-lg font-semibold text-gray-800" for="f-phone">Phone number*</label>
        <input id="f-phone" name="phone" type="tel" required autocomplete="tel"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue" />
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-lg font-semibold text-gray-800" for="f-email">Email*</label>
        <input id="f-email" name="email" type="email" required autocomplete="email"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue" />
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-lg font-semibold text-gray-800" for="f-company">Company name</label>
        <input id="f-company" name="company" type="text" autocomplete="organization"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue" />
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-lg font-semibold text-gray-800" for="f-website">Company website</label>
        <input id="f-website" name="website" type="text" inputmode="url" autocomplete="url"
          placeholder="yourcompany.com"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue" />
      </div>

      <label class="flex items-center gap-3 rounded-lg border border-gray-200 p-4 text-lg font-semibold text-gray-800">
        <input id="f-want" name="wantFeatured" type="checkbox"
          class="h-5 w-5 shrink-0 rounded border-gray-300 accent-brand-blue" />
        I want my company featured on SoCal Trades.
      </label>

      <Turnstile />

      <p id="feat-error" class="hidden text-lg font-semibold text-brand-red-dark" role="alert"></p>

      <button id="feat-btn" type="submit"
        class="tap-target rounded-lg bg-brand-blue px-6 text-lg font-semibold text-white hover:opacity-90">
        Send
      </button>
    </form>

    <div id="feat-success" class="mt-8 hidden rounded-xl border border-gray-200 bg-white p-6" hidden>
      <h2 class="text-2xl font-bold text-brand-blue">Thanks — we'll be in touch</h2>
      <p class="mt-3 text-lg text-gray-800">
        We got your enquiry and will reach out with featuring details. Prefer to
        talk now? Call us at{" "}
        <a href={`tel:${PHONE_TEL}`} class="font-semibold text-brand-blue underline">
          {PHONE_DISPLAY}
        </a>.
      </p>
    </div>
  </section>
  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  const form = document.getElementById("feat-form") as HTMLFormElement;
  const errorEl = document.getElementById("feat-error")!;
  const successEl = document.getElementById("feat-success")!;
  const btn = document.getElementById("feat-btn") as HTMLButtonElement;
  const want = document.getElementById("f-want") as HTMLInputElement;

  function showError(msg: string): void {
    errorEl.textContent = msg;
    errorEl.classList.remove("hidden");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    const data = Object.fromEntries(new FormData(form).entries());
    data.wantFeatured = want.checked as unknown as string;
    if (!data.name || !data.phone || !data.email) {
      showError("Please fill in your name, phone number, and email.");
      return;
    }
    btn.disabled = true;
    btn.textContent = "Sending…";
    try {
      const res = await fetch("/.netlify/functions/submit-featured", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        btn.disabled = false;
        btn.textContent = "Send";
        showError(body.error || "Sorry, something went wrong. Please try again.");
        return;
      }
      form.hidden = true;
      successEl.hidden = false;
      successEl.classList.remove("hidden");
      successEl.scrollIntoView({ behavior: "smooth", block: "center" });
    } catch {
      btn.disabled = false;
      btn.textContent = "Send";
      showError("Sorry, something went wrong. Please try again in a moment.");
    }
  });
</script>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import TradeIcon from "../../components/TradeIcon.astro";
import LiveStatus from "../../components/LiveStatus.astro";
import BookmarkButton from "../../components/BookmarkButton.astro";
import RatingBadge from "../../components/RatingBadge.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import {
  getPublishedBusinesses,
  getBusinessBySlug,
  getTradeMap,
  getCounties,
} from "../../lib/data";
import { businessGeoLinks } from "../../lib/links";
import { businessSchema, graph } from "../../lib/schema";

export async function getStaticPaths() {
  const businesses = await getPublishedBusinesses();
  return businesses.map((b) => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const business = await getBusinessBySlug(slug!);
if (!business) return Astro.redirect("/404");

const tradeMap = await getTradeMap();
const trade = tradeMap.get(business.trade);
const secondary = business.secondary_trades
  .map((s) => tradeMap.get(s))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));
const counties = await getCounties();
const county = counties.find((c) => c.name === business.county);
const geoLinks = await businessGeoLinks(business);

// Google Business Profile link: an explicit URL, or one built from place_id.
const googleUrl =
  business.google_url ||
  (business.google_place_id
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
        `${business.name} ${business.city}`,
      )}&query_place_id=${business.google_place_id}`
    : null);

// The stored website may be missing a scheme (e.g. "example.com"). Without one
// the browser treats it as a relative path and 404s. Prepend https:// so the
// link always points off-site.
const websiteHref = business.website
  ? /^https?:\/\//i.test(business.website)
    ? business.website
    : `https://${business.website}`
  : null;

const title = `${business.name} | ${trade?.name ?? ""} in ${business.city}, CA | SoCal Trades`;
const description = business.short_description;

// LocalBusiness JSON-LD from the shared builder. No aggregateRating/review:
// the visible rating comes from Google Business Profile, which Google's policy
// does not allow in our structured data.
const jsonLd = graph([businessSchema(business)]);
---

<BaseLayout title={title} description={description}>
  <SiteHeader slot="header" />

  <article class="mx-auto max-w-3xl px-4 py-10">
    <nav aria-label="Breadcrumb" class="text-base text-gray-600">
      {
        trade && (
          <>
            <a href={`/trades/${trade.slug}`} class="text-brand-blue hover:underline">
              {trade.name}
            </a>
            <span aria-hidden="true"> / </span>
          </>
        )
      }
      {
        county && (
          <>
            <a href={`/locations/${county.slug}`} class="text-brand-blue hover:underline">
              {county.name} County
            </a>
            <span aria-hidden="true"> / </span>
          </>
        )
      }
      <span>{business.name}</span>
    </nav>

    <a
      id="admin-edit"
      href={`/admin?edit=${business.id}`}
      class="mt-3 hidden w-fit items-center gap-2 rounded-lg border-2 border-brand-blue px-4 py-2 text-base font-semibold text-brand-blue hover:bg-brand-blue hover:text-white"
      hidden
    >
      Edit this profile (admin)
    </a>

    {
      business.photo_urls[0] && (
        <div class="group relative mt-4 aspect-[16/9] w-full overflow-hidden rounded-2xl">
          <img
            src={business.photo_urls[0]}
            alt={business.name}
            loading="eager"
            class="h-full w-full object-cover"
          />
          <span class="pointer-events-none absolute inset-0 bg-brand-blue/25 transition-opacity duration-300 group-hover:opacity-0" />
        </div>
      )
    }

    <header class="mt-4 flex items-start gap-4">
      <span class="mt-1 shrink-0 text-brand-red-dark">
        <TradeIcon icon={trade?.icon ?? "wrench"} class="h-12 w-12" />
      </span>
      <div class="min-w-0 flex-1">
        <h1 class="text-3xl sm:text-4xl font-bold text-brand-blue break-words">
          {business.name}
        </h1>
        <p class="mt-1 text-lg text-gray-700">
          {trade?.name}{" "}&middot; {business.city}, {business.county} County
        </p>
        <RatingBadge rating={business.rating} count={business.review_count} full class="mt-2 text-lg" />
        {
          business.rating != null && (
            <p class="mt-1 text-sm text-gray-500">
              Rating from company{" "}
              {googleUrl ? (
                <a
                  href={googleUrl}
                  target="_blank"
                  rel="nofollow noopener"
                  class="text-brand-blue underline"
                >
                  Google Business Profile
                </a>
              ) : (
                "Google Business Profile"
              )}
            </p>
          )
        }
      </div>
      <BookmarkButton slug={business.slug} variant="inline" class="mt-1 shrink-0" />
    </header>

    {/* Live open/closed + rating (Phase 2). Absent until a place_id is set. */}
    <div class="mt-4">
      <LiveStatus placeId={business.google_place_id} />
    </div>

    {/* Big, obvious contact actions. */}
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      {
        business.phone && (
          <a
            href={`tel:${business.phone}`}
            class="tap-target flex flex-1 items-center justify-center gap-2 rounded-lg bg-brand-blue px-6 text-lg font-semibold text-white hover:opacity-90"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 shrink-0" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path></svg>
            Call {business.name}
          </a>
        )
      }
      {
        business.email && (
          <a
            href={`mailto:${business.email}`}
            class="tap-target flex flex-1 items-center justify-center gap-2 rounded-lg bg-brand-red-dark px-6 text-lg font-semibold text-white hover:opacity-90"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 shrink-0" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
            Email
          </a>
        )
      }
    </div>

    {
      business.long_description && (
        <section class="mt-8">
          <h2 class="text-2xl font-bold text-brand-blue">About</h2>
          <p class="mt-3 text-lg text-gray-800">{business.long_description}</p>
        </section>
      )
    }

    {
      business.keywords && business.keywords.length > 0 && (
        <section class="mt-8">
          <h2 class="text-2xl font-bold text-brand-blue">Services &amp; specialties</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {business.keywords.map((kw) => (
              <li>
                <a
                  href={`/search?q=${encodeURIComponent(kw)}`}
                  class="tap-target inline-flex items-center rounded-full border border-brand-blue/30 bg-brand-cream px-4 py-1 text-base font-medium text-brand-blue hover:bg-brand-blue hover:text-white"
                >
                  {kw}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-8">
      <h2 class="text-2xl font-bold text-brand-blue">Details</h2>
      <dl class="mt-3 space-y-3 text-lg">
        {
          business.address && (
            <div>
              <dt class="font-semibold text-gray-700">Address</dt>
              <dd class="text-gray-900">{business.address}</dd>
            </div>
          )
        }
        {
          business.website && (
            <div>
              <dt class="font-semibold text-gray-700">Website</dt>
              <dd>
                <a
                  href={websiteHref}
                  target="_blank"
                  rel="nofollow noopener"
                  class="text-brand-blue underline break-words"
                >
                  {business.website.replace(/^https?:\/\//i, "")}
                </a>
              </dd>
            </div>
          )
        }
        {
          business.service_areas.length > 0 && (
            <div>
              <dt class="font-semibold text-gray-700">Service areas</dt>
              <dd class="text-gray-900">{business.service_areas.join(", ")}</dd>
            </div>
          )
        }
        {
          secondary.length > 0 && (
            <div>
              <dt class="font-semibold text-gray-700">Also does</dt>
              <dd class="flex flex-wrap gap-2 pt-1">
                {secondary.map((t) => (
                  <a
                    href={`/trades/${t.slug}`}
                    class="inline-flex rounded-lg border border-brand-blue px-3 py-1 text-base text-brand-blue hover:bg-brand-blue hover:text-white"
                  >
                    {t.name}
                  </a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </section>

    {/* Live Google reviews (shares the one fetch with the summary island). */}
    <div class="mt-10">
      <LiveStatus placeId={business.google_place_id} variant="reviews" />
    </div>

    {
      geoLinks.length > 0 && (
        <nav aria-label="Explore nearby" class="mt-10">
          <h2 class="text-xl font-bold text-brand-blue">Explore more in the area</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {geoLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="tap-target inline-flex items-center rounded-lg border border-brand-blue px-4 py-1 text-base text-brand-blue hover:bg-brand-blue hover:text-white"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      business.claimable !== false && (
        <section class="mt-10 rounded-xl border border-gray-200 bg-white p-5">
          <h2 class="text-xl font-bold text-brand-blue">Is this your business?</h2>
          <p class="mt-2 text-lg text-gray-800">
            Claim this profile with your work email to keep it up to date.
          </p>
          <a
            href={`/business/${business.slug}/claim`}
            class="tap-target mt-4 inline-flex items-center rounded-lg border-2 border-brand-blue px-6 text-lg font-semibold text-brand-blue hover:bg-brand-blue hover:text-white"
          >
            Claim this profile
          </a>
        </section>
      )
    }

    <p class="mt-6 text-base text-gray-600">
      Listed here?{" "}
      <a
        href={business.claimed_by ? `/badge/?b=${business.slug}` : "/badge/"}
        class="font-semibold text-brand-blue underline"
      >
        Get your badge
      </a>{" "}
      to show customers you're on SoCal Trades.
    </p>
  </article>

  <script
    type="application/ld+json"
    is:inline
    set:html={jsonLd}
  />

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { getSupabase, isConfigured } from "../../lib/supabaseClient";

  // Reveal the admin-only edit link. Real edit access is enforced by RLS in
  // the admin editor regardless; this only controls whether the link shows.
  function reveal(): void {
    const el = document.getElementById("admin-edit");
    el?.removeAttribute("hidden");
    el?.classList.remove("hidden");
    el?.classList.add("inline-flex");
  }

  // Fast path: the flag set on the account/admin pages shows the link instantly.
  let flagged = false;
  try {
    flagged = localStorage.getItem("st_admin") === "1";
  } catch {
    /* storage blocked */
  }
  if (flagged) reveal();

  // Reliable path: if someone is signed in, confirm admin against Supabase so
  // the link works even when the flag was never set in this browser. Anonymous
  // visitors have no local session, so this makes no network call for them.
  async function confirmAdmin(): Promise<void> {
    if (!isConfigured()) return;
    const supabase = getSupabase();
    if (!supabase) return;
    const { data: sessionData } = await supabase.auth.getSession();
    const user = sessionData.session?.user;
    if (!user) {
      try { localStorage.removeItem("st_admin"); } catch { /* ignore */ }
      return;
    }
    const { data: adminRow } = await supabase
      .from("admins")
      .select("user_id")
      .eq("user_id", user.id)
      .maybeSingle();
    if (adminRow) {
      try { localStorage.setItem("st_admin", "1"); } catch { /* ignore */ }
      if (!flagged) reveal();
    } else {
      try { localStorage.removeItem("st_admin"); } catch { /* ignore */ }
    }
  }
  confirmAdmin().catch(() => { /* leave the flag-based state as-is */ });
</script>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Reset your password | SoCal Trades"
  description="Reset your SoCal Trades password."
>
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-md px-4 py-12">
    <h1 class="text-3xl font-bold text-brand-blue">Reset your password</h1>
    <p class="mt-3 text-lg text-gray-800">
      Enter your email and we will send a link to set a new password.
    </p>

    <form id="forgot-form" class="mt-8 flex flex-col gap-4" novalidate>
      <label class="text-lg font-semibold text-gray-800" for="forgot-email">Email</label>
      <input
        id="forgot-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue"
      />
      <button
        id="forgot-btn"
        type="submit"
        class="tap-target rounded-lg bg-brand-blue px-6 text-lg font-semibold text-white hover:opacity-90"
      >
        Send reset link
      </button>
      <p id="forgot-msg" class="hidden text-lg" role="alert"></p>
      <p class="text-lg text-gray-700">
        <a href="/login" class="text-brand-blue underline">Back to log in</a>
      </p>
    </form>

    <div id="forgot-sent" class="mt-8 hidden rounded-xl border border-gray-200 bg-white p-6" hidden>
      <h2 class="text-2xl font-bold text-brand-blue">Check your email</h2>
      <p class="mt-3 text-lg text-gray-800">
        If an account exists for that email, a reset link is on its way. Open it
        to set a new password.
      </p>
    </div>

    <div id="forgot-unavailable" class="mt-8 hidden rounded-xl border border-gray-200 bg-white p-6" hidden>
      <p class="text-lg text-gray-800">Accounts are not switched on yet.</p>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { getSupabase, isConfigured } from "../lib/supabaseClient";

  const form = document.getElementById("forgot-form") as HTMLFormElement;
  const emailInput = document.getElementById("forgot-email") as HTMLInputElement;
  const btn = document.getElementById("forgot-btn") as HTMLButtonElement;
  const msg = document.getElementById("forgot-msg")!;
  const sent = document.getElementById("forgot-sent")!;
  const unavailable = document.getElementById("forgot-unavailable")!;

  if (!isConfigured()) {
    form.hidden = true;
    unavailable.hidden = false;
    unavailable.classList.remove("hidden");
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    msg.classList.add("hidden");
    const email = emailInput.value.trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      msg.textContent = "Please enter a valid email address.";
      msg.classList.remove("hidden");
      msg.classList.add("text-brand-red-dark", "font-semibold");
      return;
    }
    const supabase = getSupabase();
    if (!supabase) return;

    btn.disabled = true;
    btn.textContent = "Sending…";
    await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${location.origin}/reset`,
    });
    // Always show the same confirmation, whether or not the email exists.
    form.hidden = true;
    sent.hidden = false;
    sent.classList.remove("hidden");
  });
</script>

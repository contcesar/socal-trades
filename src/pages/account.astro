---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout title="Your account | SoCal Trades" description="Your SoCal Trades account.">
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-md px-4 py-12">
    <h1 class="text-3xl font-bold text-brand-blue">Your account</h1>

    <div id="acct-loading" class="mt-6 text-lg text-gray-700">Loading…</div>

    <div id="acct-body" class="mt-6 hidden" hidden>
      <p class="text-lg text-gray-800">
        Signed in as <span id="acct-email" class="font-semibold"></span>.
      </p>

      <a
        id="admin-link"
        href="/admin"
        class="tap-target mt-8 hidden min-h-[56px] items-center justify-center rounded-xl border-2 border-brand-blue px-8 text-xl font-bold text-brand-blue hover:bg-brand-blue hover:text-white"
      >
        Go to admin
      </a>

      <div class="mt-6">
        <a href="/saved" class="text-lg text-brand-blue underline">Saved companies</a>
      </div>

      <section class="mt-8 rounded-xl border border-gray-200 bg-white p-5">
        <h2 class="text-xl font-bold text-brand-blue">Change password</h2>
        <form id="pw-form" class="mt-4 flex flex-col gap-4" novalidate>
          <div class="flex flex-col gap-1">
            <label class="text-base font-semibold text-gray-800" for="pw-new">
              New password
              <span class="font-normal text-gray-600">(at least 8 characters)</span>
            </label>
            <input id="pw-new" type="password" autocomplete="new-password" minlength="8"
              class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue" />
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-base font-semibold text-gray-800" for="pw-confirm">Confirm new password</label>
            <input id="pw-confirm" type="password" autocomplete="new-password"
              class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue" />
          </div>
          <p id="pw-msg" class="hidden text-base" role="alert"></p>
          <button id="pw-btn" type="submit"
            class="tap-target rounded-lg bg-brand-blue px-6 text-lg font-semibold text-white hover:opacity-90">
            Update password
          </button>
        </form>
      </section>

      <button
        id="logout-btn"
        type="button"
        class="tap-target mt-8 rounded-lg bg-brand-blue px-6 text-lg font-semibold text-white hover:opacity-90"
      >
        Log out
      </button>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { getSupabase, isConfigured, setAuthFlag } from "../lib/supabaseClient";

  const loading = document.getElementById("acct-loading")!;
  const body = document.getElementById("acct-body")!;
  const emailEl = document.getElementById("acct-email")!;
  const adminLink = document.getElementById("admin-link")!;
  const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;

  async function run(): Promise<void> {
    if (!isConfigured()) {
      location.replace("/login");
      return;
    }
    const supabase = getSupabase()!;
    const { data } = await supabase.auth.getUser();
    const user = data.user;
    if (!user) {
      location.replace("/login?next=/account");
      return;
    }

    setAuthFlag(user.email ?? "account");
    emailEl.textContent = user.email ?? "your account";
    loading.hidden = true;
    body.hidden = false;
    body.classList.remove("hidden");

    // Show the admin link only if this user has an admins row (RLS allows a
    // user to read their own admin row).
    try {
      const { data: adminRow } = await supabase
        .from("admins")
        .select("user_id")
        .eq("user_id", user.id)
        .maybeSingle();
      if (adminRow) {
        adminLink.hidden = false;
        adminLink.classList.remove("hidden");
        adminLink.classList.add("inline-flex");
        try { localStorage.setItem("st_admin", "1"); } catch { /* ignore */ }
      } else {
        try { localStorage.removeItem("st_admin"); } catch { /* ignore */ }
      }
    } catch {
      /* admins table may not exist yet; ignore */
    }

    // Change password (the active session authorizes the update).
    const pwForm = document.getElementById("pw-form") as HTMLFormElement;
    const pwNew = document.getElementById("pw-new") as HTMLInputElement;
    const pwConfirm = document.getElementById("pw-confirm") as HTMLInputElement;
    const pwBtn = document.getElementById("pw-btn") as HTMLButtonElement;
    const pwMsg = document.getElementById("pw-msg")!;
    function pwShow(text: string, ok = false): void {
      pwMsg.textContent = text;
      pwMsg.classList.remove("hidden", "text-brand-red-dark", "text-green-700", "font-semibold");
      pwMsg.classList.add(ok ? "text-green-700" : "text-brand-red-dark", "font-semibold");
    }
    pwForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      pwMsg.classList.add("hidden");
      const pw = pwNew.value;
      if (pw.length < 8) {
        pwShow("Password must be at least 8 characters.");
        return;
      }
      if (pw !== pwConfirm.value) {
        pwShow("The passwords do not match.");
        return;
      }
      pwBtn.disabled = true;
      pwBtn.textContent = "Updating…";
      const { error } = await supabase.auth.updateUser({ password: pw });
      pwBtn.disabled = false;
      pwBtn.textContent = "Update password";
      if (error) {
        pwShow(error.message);
        return;
      }
      pwForm.reset();
      pwShow("Password updated.", true);
    });

    logoutBtn.addEventListener("click", async () => {
      logoutBtn.disabled = true;
      await supabase.auth.signOut();
      setAuthFlag(null);
      try {
        localStorage.removeItem("st_company");
        localStorage.removeItem("st_admin");
      } catch {
        /* ignore */
      }
      location.replace("/");
    });
  }

  run();
</script>

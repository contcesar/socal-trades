---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Saved companies | SoCal Trades"
  description="The trades companies you have bookmarked."
>
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-7xl px-4 py-8">
    <h1 class="text-3xl font-bold text-brand-blue">Saved companies</h1>
    <p class="mt-2 text-lg text-gray-700">
      Bookmarks are saved on this device.
    </p>

    <p id="saved-empty" class="mt-8 text-lg text-gray-700">
      You have not saved any companies yet. Tap the bookmark icon on any company
      to save it here.
    </p>

    <div
      id="saved-results"
      class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4"
    >
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  interface IndexItem {
    name: string;
    slug: string;
    tradeName: string;
    city: string;
    county: string;
    shortDescription: string;
    rating: number | null;
    reviewCount: number | null;
  }

  const KEY = "st_bookmarks";
  const resultsEl = document.getElementById("saved-results")!;
  const emptyEl = document.getElementById("saved-empty")!;

  const read = (): Set<string> => {
    try {
      return new Set(JSON.parse(localStorage.getItem(KEY) || "[]"));
    } catch {
      return new Set();
    }
  };
  const escapeHtml = (s: string): string =>
    s.replace(
      /[&<>"']/g,
      (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[
          c
        ]!,
    );

  function card(item: IndexItem): string {
    return `
      <article class="group">
        <div class="relative">
          <a href="/business/${item.slug}" class="block aspect-[4/3] overflow-hidden rounded-2xl bg-brand-cream">
            <span class="flex h-full w-full items-center justify-center px-3 text-center text-base font-semibold text-brand-blue">${escapeHtml(item.tradeName)}</span>
          </a>
          <button type="button" class="bookmark-btn tap-target absolute right-3 top-3 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/90 text-brand-blue shadow-md hover:bg-white" data-slug="${item.slug}" aria-pressed="true" aria-label="Remove bookmark" title="Remove bookmark">
            <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"></path></svg>
          </button>
        </div>
        <a href="/business/${item.slug}" class="mt-3 block">
          <div class="flex items-start justify-between gap-2">
            <h3 class="text-lg font-bold leading-snug text-gray-900">${escapeHtml(item.name)}</h3>
            ${item.rating != null ? `<span class="mt-0.5 inline-flex shrink-0 items-center gap-1 text-base"><span class="text-amber-500">★</span><span class="font-semibold text-gray-900">${item.rating.toFixed(1)}</span>${item.reviewCount ? `<span class="text-gray-500">(${item.reviewCount})</span>` : ""}</span>` : ""}
          </div>
          <p class="mt-0.5 text-base text-gray-600">${escapeHtml(item.tradeName)} &middot; ${escapeHtml(item.city)}, ${escapeHtml(item.county)} County</p>
        </a>
      </article>`;
  }

  let all: IndexItem[] = [];

  function renderSaved(): void {
    const saved = read();
    const items = all.filter((i) => saved.has(i.slug));
    resultsEl.innerHTML = items.map(card).join("");
    emptyEl.hidden = items.length > 0;
    document.dispatchEvent(new CustomEvent("cards:rendered"));
  }

  async function init(): Promise<void> {
    try {
      const res = await fetch("/businesses.json");
      all = await res.json();
    } catch {
      return;
    }
    renderSaved();
    // Re-render when a bookmark is toggled anywhere on this page.
    document.addEventListener("bookmarks:changed", renderSaved);
  }

  init();
</script>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BusinessCard from "../../components/BusinessCard.astro";
import TradeIcon from "../../components/TradeIcon.astro";
import SeoIntro from "../../components/SeoIntro.astro";
import SeoFaqs from "../../components/SeoFaqs.astro";
import {
  getTrades,
  getTradeBySlug,
  getBusinessesByTrade,
  getCounties,
} from "../../lib/data";
import {
  isIndexableCount,
  tradeTitle,
  tradeH1,
  tradeDescription,
  tradePlural,
  genericIntro,
} from "../../lib/seo";
import { getLocalContent } from "../../content/localSeo";

export async function getStaticPaths() {
  const trades = await getTrades();
  return trades.map((trade) => ({ params: { trade: trade.slug } }));
}

const { trade: tradeSlug } = Astro.params;
const trade = await getTradeBySlug(tradeSlug!);
if (!trade) return Astro.redirect("/404");

const businesses = await getBusinessesByTrade(trade.slug);
const counties = await getCounties();
// Counties that actually have a business in this trade, for filter links.
const countyNames = new Set(businesses.map((b) => b.county));
const activeCounties = counties.filter((c) => countyNames.has(c.name));

const title = tradeTitle(trade.slug, trade.name);
const description = tradeDescription(businesses.length, trade.slug, trade.name);
const h1 = tradeH1(trade.slug, trade.name);
const noindex = !isIndexableCount(businesses.length);

const content = getLocalContent(Astro.url.pathname);
if (!content && !noindex) {
  console.warn(`[seo] Missing local content entry for ${Astro.url.pathname} (indexable) — using generic intro.`);
}
const introText =
  content?.intro ??
  (noindex ? null : genericIntro(tradePlural(trade.slug, trade.name).toLowerCase(), "Southern California"));
const faqs = content?.faqs ?? [];
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-7xl px-4 py-10">
    <div class="flex items-center gap-3">
      <span class="text-brand-red-dark"><TradeIcon icon={trade.icon} class="h-10 w-10" /></span>
      <h1 class="text-3xl sm:text-4xl font-bold text-brand-blue">{h1}</h1>
    </div>
    <p class="mt-3 text-lg text-gray-700">
      {businesses.length}
      {businesses.length === 1 ? "company" : "companies"} listed across Southern
      California.
    </p>

    {
      activeCounties.length > 0 && (
        <nav aria-label="Filter by county" class="mt-6 flex flex-wrap gap-2">
          {activeCounties.map((c) => (
            <a
              href={`/trades/${trade.slug}/${c.slug}`}
              class="tap-target inline-flex items-center rounded-lg border border-brand-blue px-4 text-base text-brand-blue hover:bg-brand-blue hover:text-white"
            >
              {c.name} County
            </a>
          ))}
        </nav>
      )
    }
    {introText && <SeoIntro text={introText} />}
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16">
    {
      businesses.length === 0 ? (
        <p class="text-lg text-gray-700">
          No companies listed here yet. Check back soon.
        </p>
      ) : (
        <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
          {businesses.map((b) => (
            <BusinessCard business={b} trade={trade} />
          ))}
        </div>
      )
    }
  </section>

  <SeoFaqs faqs={faqs} />

  <SiteFooter slot="footer" />
</BaseLayout>

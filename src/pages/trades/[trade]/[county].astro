---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import BusinessCard from "../../../components/BusinessCard.astro";
import SeoIntro from "../../../components/SeoIntro.astro";
import SeoFaqs from "../../../components/SeoFaqs.astro";
import RelatedLinks from "../../../components/RelatedLinks.astro";
import { relatedTradeCountyLinks } from "../../../lib/links";
import { itemListSchema, breadcrumbSchema, faqSchema, graph } from "../../../lib/schema";
import {
  getTrades,
  getCounties,
  getTradeBySlug,
  getCountyBySlug,
  getBusinessesByTradeAndCounty,
} from "../../../lib/data";
import {
  isIndexableCount,
  tradeCountyTitle,
  tradeCountyH1,
  tradeCountyDescription,
  tradePlural,
  genericIntro,
} from "../../../lib/seo";
import { getLocalContent } from "../../../content/localSeo";

// Only generate trade+county pages that actually have listings.
export async function getStaticPaths() {
  const trades = await getTrades();
  const counties = await getCounties();
  const paths = [];
  for (const trade of trades) {
    for (const county of counties) {
      const businesses = await getBusinessesByTradeAndCounty(trade.slug, county.slug);
      if (businesses.length > 0) {
        paths.push({ params: { trade: trade.slug, county: county.slug } });
      }
    }
  }
  return paths;
}

const { trade: tradeSlug, county: countySlug } = Astro.params;
const trade = await getTradeBySlug(tradeSlug!);
const county = await getCountyBySlug(countySlug!);
if (!trade || !county) return Astro.redirect("/404");

const businesses = await getBusinessesByTradeAndCounty(trade.slug, county.slug);

const title = tradeCountyTitle(trade.slug, trade.name, county.name);
const description = tradeCountyDescription(
  businesses.length,
  trade.slug,
  trade.name,
  county.name,
);
const h1 = tradeCountyH1(trade.slug, trade.name, county.name);
const noindex = !isIndexableCount(businesses.length);

// Local content: a reviewed entry if we have one, otherwise a generic intro on
// indexable pages (and a build warning so missing entries are easy to spot).
const content = getLocalContent(Astro.url.pathname);
if (!content && !noindex) {
  console.warn(`[seo] Missing local content entry for ${Astro.url.pathname} (indexable) — using generic intro.`);
}
const introText =
  content?.intro ??
  (noindex
    ? null
    : genericIntro(`${tradePlural(trade.slug, trade.name).toLowerCase()}`, `${county.name} County`));
const faqs = content?.faqs ?? [];
const relatedLinks = await relatedTradeCountyLinks(trade.slug, county.slug);

// JSON-LD: ItemList + BreadcrumbList, and FAQPage only when the FAQs are
// reviewed (so unverified [VERIFY] drafts never enter structured data).
const jsonLd = graph([
  itemListSchema(businesses),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: trade.name, path: `/trades/${trade.slug}/` },
    { name: `${county.name} County` },
  ]),
  content?.reviewed && faqs.length ? faqSchema(faqs) : null,
]);
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-7xl px-4 py-10">
    <nav aria-label="Breadcrumb" class="text-base text-gray-600">
      <a href="/" class="text-brand-blue hover:underline">Home</a>
      <span aria-hidden="true"> / </span>
      <a href={`/trades/${trade.slug}`} class="text-brand-blue hover:underline">
        {trade.name}
      </a>
      <span aria-hidden="true"> / </span>
      <span>{county.name} County</span>
    </nav>
    <h1 class="mt-2 text-3xl sm:text-4xl font-bold text-brand-blue">
      {h1}
    </h1>
    <p class="mt-3 text-lg text-gray-700">
      {businesses.length}
      {businesses.length === 1 ? "company" : "companies"} serving {county.name} County.
    </p>
    {introText && <SeoIntro text={introText} />}
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16">
    <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
      {businesses.map((b) => <BusinessCard business={b} trade={trade} />)}
    </div>
  </section>

  <RelatedLinks title={`Related trades in ${county.name} County`} links={relatedLinks} />

  <SeoFaqs faqs={faqs} />

  <script type="application/ld+json" is:inline set:html={jsonLd} />

  <SiteFooter slot="footer" />
</BaseLayout>

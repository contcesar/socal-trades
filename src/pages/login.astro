---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Turnstile from "../components/Turnstile.astro";
---

<BaseLayout
  title="Log in | SoCal Trades"
  description="Log in to your SoCal Trades account."
>
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-md px-4 py-12">
    <h1 class="text-3xl font-bold text-brand-blue">Log in</h1>
    <p class="mt-3 text-lg text-gray-800">
      Enter your email and password.
    </p>

    <form id="login-form" class="mt-8 flex flex-col gap-5" novalidate>
      <div class="flex flex-col gap-2">
        <label class="text-lg font-semibold text-gray-800" for="login-email">Email</label>
        <input
          id="login-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue"
        />
      </div>
      <div class="flex flex-col gap-2">
        <label class="text-lg font-semibold text-gray-800" for="login-password">Password</label>
        <input
          id="login-password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue"
        />
      </div>

      <Turnstile />

      <button
        id="login-btn"
        type="submit"
        class="tap-target rounded-lg bg-brand-blue px-6 text-lg font-semibold text-white hover:opacity-90"
      >
        Log in
      </button>
      <p id="login-msg" class="hidden text-lg" role="alert"></p>

      <div class="flex flex-col gap-1 text-lg text-gray-700">
        <a href="/forgot" class="text-brand-blue underline">Forgot your password?</a>
        <span>New here? <a href="/signup" class="text-brand-blue underline">Sign up</a>.</span>
      </div>
    </form>

    <div id="login-unavailable" class="mt-8 hidden rounded-xl border border-gray-200 bg-white p-6" hidden>
      <p class="text-lg text-gray-800">
        Login is not switched on yet. It goes live once the site is connected to
        its accounts service.
      </p>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { getSupabase, isConfigured, setAuthFlag } from "../lib/supabaseClient";
  import { turnstileToken } from "../lib/turnstile";

  const form = document.getElementById("login-form") as HTMLFormElement;
  const emailInput = document.getElementById("login-email") as HTMLInputElement;
  const passwordInput = document.getElementById("login-password") as HTMLInputElement;
  const btn = document.getElementById("login-btn") as HTMLButtonElement;
  const msg = document.getElementById("login-msg")!;
  const unavailable = document.getElementById("login-unavailable")!;

  if (!isConfigured()) {
    form.hidden = true;
    unavailable.hidden = false;
    unavailable.classList.remove("hidden");
  }

  function showError(text: string): void {
    msg.textContent = text;
    msg.classList.remove("hidden");
    msg.classList.add("text-brand-red-dark", "font-semibold");
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    msg.classList.add("hidden");
    const email = emailInput.value.trim();
    const password = passwordInput.value;
    if (!email || !password) {
      showError("Please enter your email and password.");
      return;
    }
    const supabase = getSupabase();
    if (!supabase) return;

    btn.disabled = true;
    btn.textContent = "Logging in…";
    const captchaToken = turnstileToken(form);
    const { data, error } = await supabase.auth.signInWithPassword({
      email,
      password,
      options: captchaToken ? { captchaToken } : undefined,
    });
    if (error) {
      btn.disabled = false;
      btn.textContent = "Log in";
      showError(error.message);
      return;
    }
    setAuthFlag(data.user?.email ?? email);
    const next = new URLSearchParams(location.search).get("next");
    location.replace(next && next.startsWith("/") ? next : "/account");
  });
</script>

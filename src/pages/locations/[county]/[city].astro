---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import BusinessCard from "../../../components/BusinessCard.astro";
import SeoIntro from "../../../components/SeoIntro.astro";
import SeoFaqs from "../../../components/SeoFaqs.astro";
import RelatedLinks from "../../../components/RelatedLinks.astro";
import { nearbyCityLinks } from "../../../lib/links";
import { itemListSchema, breadcrumbSchema, faqSchema, graph } from "../../../lib/schema";
import {
  getAllCities,
  getCountyBySlug,
  getBusinessesByCity,
  getTradeMap,
} from "../../../lib/data";
import {
  isIndexableCount,
  cityTitle,
  cityH1,
  cityDescription,
  genericIntro,
} from "../../../lib/seo";
import { getLocalContent } from "../../../content/localSeo";

// One page per (county, city) pair that has a published business.
export async function getStaticPaths() {
  const cities = await getAllCities();
  return cities.map((city) => ({
    params: { county: city.county.slug, city: city.slug },
    props: { cityName: city.name },
  }));
}

const { county: countySlug, city: citySlug } = Astro.params;
const { cityName } = Astro.props;
const county = await getCountyBySlug(countySlug!);
if (!county) return Astro.redirect("/404");

const businesses = await getBusinessesByCity(county.slug, citySlug!);
const tradeMap = await getTradeMap();

const title = cityTitle(cityName);
const description = cityDescription(businesses.length, cityName);
const h1 = cityH1(cityName);
const noindex = !isIndexableCount(businesses.length);

const content = getLocalContent(Astro.url.pathname);
if (!content && !noindex) {
  console.warn(`[seo] Missing local content entry for ${Astro.url.pathname} (indexable) — using generic intro.`);
}
const introText =
  content?.intro ?? (noindex ? null : genericIntro("trades companies", cityName));
const faqs = content?.faqs ?? [];
const nearbyLinks = await nearbyCityLinks(citySlug!);

const jsonLd = graph([
  itemListSchema(businesses),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: `${county.name} County`, path: `/locations/${county.slug}/` },
    { name: cityName },
  ]),
  content?.reviewed && faqs.length ? faqSchema(faqs) : null,
]);
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-7xl px-4 py-10">
    <nav aria-label="Breadcrumb" class="text-base text-gray-600">
      <a href="/" class="text-brand-blue hover:underline">Home</a>
      <span aria-hidden="true"> / </span>
      <a href={`/locations/${county.slug}`} class="text-brand-blue hover:underline">
        {county.name} County
      </a>
      <span aria-hidden="true"> / </span>
      <span>{cityName}</span>
    </nav>
    <h1 class="mt-2 text-3xl sm:text-4xl font-bold text-brand-blue">
      {h1}
    </h1>
    <p class="mt-3 text-lg text-gray-700">
      {businesses.length}
      {businesses.length === 1 ? "company" : "companies"} serving {cityName}.
    </p>
    {introText && <SeoIntro text={introText} />}
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16">
    <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
      {businesses.map((b) => <BusinessCard business={b} trade={tradeMap.get(b.trade)} />)}
    </div>
  </section>

  <RelatedLinks title="Trades in nearby cities" links={nearbyLinks} />

  <SeoFaqs faqs={faqs} />

  <script type="application/ld+json" is:inline set:html={jsonLd} />

  <SiteFooter slot="footer" />
</BaseLayout>

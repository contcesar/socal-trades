---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BusinessCard from "../../components/BusinessCard.astro";
import SeoIntro from "../../components/SeoIntro.astro";
import SeoFaqs from "../../components/SeoFaqs.astro";
import {
  getCounties,
  getCountyBySlug,
  getBusinessesByCounty,
  getCitiesForCounty,
  getTradeMap,
} from "../../lib/data";
import {
  isIndexableCount,
  countyTitle,
  countyH1,
  countyDescription,
  genericIntro,
} from "../../lib/seo";
import { getLocalContent } from "../../content/localSeo";
import { itemListSchema, breadcrumbSchema, faqSchema, graph } from "../../lib/schema";

export async function getStaticPaths() {
  const counties = await getCounties();
  return counties.map((county) => ({ params: { county: county.slug } }));
}

const { county: countySlug } = Astro.params;
const county = await getCountyBySlug(countySlug!);
if (!county) return Astro.redirect("/404");

const businesses = await getBusinessesByCounty(county.slug);
const cities = await getCitiesForCounty(county.slug);
const tradeMap = await getTradeMap();

const title = countyTitle(county.name);
const description = countyDescription(businesses.length, county.name);
const h1 = countyH1(county.name);
const noindex = !isIndexableCount(businesses.length);

const content = getLocalContent(Astro.url.pathname);
if (!content && !noindex) {
  console.warn(`[seo] Missing local content entry for ${Astro.url.pathname} (indexable) — using generic intro.`);
}
const introText =
  content?.intro ??
  (noindex ? null : genericIntro("trades companies", `${county.name} County`));
const faqs = content?.faqs ?? [];

const jsonLd = graph([
  itemListSchema(businesses),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: `${county.name} County` },
  ]),
  content?.reviewed && faqs.length ? faqSchema(faqs) : null,
]);
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-7xl px-4 py-10">
    <nav aria-label="Breadcrumb" class="text-base text-gray-600">
      <a href="/" class="text-brand-blue hover:underline">Home</a>
      <span aria-hidden="true"> / </span>
      <span>{county.name} County</span>
    </nav>
    <h1 class="mt-2 text-3xl sm:text-4xl font-bold text-brand-blue">
      {h1}
    </h1>
    <p class="mt-3 text-lg text-gray-700">
      {businesses.length}
      {businesses.length === 1 ? "company" : "companies"} listed.
    </p>

    {
      cities.length > 0 && (
        <nav aria-label="Cities in this county" class="mt-6 flex flex-wrap gap-2">
          {cities.map((city) =>
            isIndexableCount(city.count) ? (
              <a
                href={`/locations/${county.slug}/${city.slug}/`}
                class="tap-target inline-flex items-center rounded-lg border border-brand-blue px-4 text-base text-brand-blue hover:bg-brand-blue hover:text-white"
              >
                {city.name} ({city.count})
              </a>
            ) : (
              <span class="tap-target inline-flex items-center rounded-lg border border-gray-300 px-4 text-base text-gray-500">
                {city.name} ({city.count})
              </span>
            ),
          )}
        </nav>
      )
    }
    {introText && <SeoIntro text={introText} />}
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16">
    {
      businesses.length === 0 ? (
        <p class="text-lg text-gray-700">No companies listed here yet.</p>
      ) : (
        <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
          {businesses.map((b) => (
            <BusinessCard business={b} trade={tradeMap.get(b.trade)} />
          ))}
        </div>
      )
    }
  </section>

  <SeoFaqs faqs={faqs} />

  <script type="application/ld+json" is:inline set:html={jsonLd} />

  <SiteFooter slot="footer" />
</BaseLayout>

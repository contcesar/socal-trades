---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Sign up | SoCal Trades"
  description="Create a SoCal Trades account with a one-time email link."
>
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-md px-4 py-12">
    <h1 class="text-3xl font-bold text-brand-blue">Sign up</h1>
    <p class="mt-3 text-lg text-gray-800">
      Enter your email and we will send you a one-time link to finish. No
      password needed.
    </p>

    <form id="signup-form" class="mt-8 flex flex-col gap-5" novalidate>
      <div class="flex flex-col gap-2">
        <label class="text-lg font-semibold text-gray-800" for="signup-email">
          Email
        </label>
        <input
          id="signup-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue"
        />
      </div>

      <label class="flex items-start gap-3 rounded-lg border-2 border-gray-300 bg-white p-4">
        <input
          id="is-owner"
          name="owner"
          type="checkbox"
          class="mt-1 h-6 w-6 shrink-0 accent-brand-blue"
        />
        <span class="text-lg text-gray-800">
          I own a business in the trades
          <span class="mt-1 block text-base text-gray-600">
            We will take you to add your company after you sign in.
          </span>
        </span>
      </label>

      <button
        id="signup-btn"
        type="submit"
        class="tap-target rounded-lg bg-brand-blue px-6 text-lg font-semibold text-white hover:opacity-90"
      >
        Send me a sign-up link
      </button>
      <p id="signup-msg" class="hidden text-lg" role="alert"></p>

      <p class="text-lg text-gray-700">
        Already have an account?
        <a href="/login" class="text-brand-blue underline">Log in</a>.
      </p>
    </form>

    <div id="signup-sent" class="mt-8 hidden rounded-xl border border-gray-200 bg-white p-6" hidden>
      <h2 class="text-2xl font-bold text-brand-blue">Check your email</h2>
      <p class="mt-3 text-lg text-gray-800">
        We sent a link to <span id="sent-to" class="font-semibold"></span>. Open
        it on this device to finish.
      </p>
    </div>

    <div id="signup-unavailable" class="mt-8 hidden rounded-xl border border-gray-200 bg-white p-6" hidden>
      <p class="text-lg text-gray-800">
        Sign up is not switched on yet. It goes live once the site is connected
        to its accounts service.
      </p>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { getSupabase, isConfigured } from "../lib/supabaseClient";

  const form = document.getElementById("signup-form") as HTMLFormElement;
  const emailInput = document.getElementById("signup-email") as HTMLInputElement;
  const ownerInput = document.getElementById("is-owner") as HTMLInputElement;
  const btn = document.getElementById("signup-btn") as HTMLButtonElement;
  const msg = document.getElementById("signup-msg")!;
  const sent = document.getElementById("signup-sent")!;
  const sentTo = document.getElementById("sent-to")!;
  const unavailable = document.getElementById("signup-unavailable")!;

  if (!isConfigured()) {
    form.hidden = true;
    unavailable.hidden = false;
    unavailable.classList.remove("hidden");
  }

  function showError(text: string): void {
    msg.textContent = text;
    msg.classList.remove("hidden");
    msg.classList.add("text-brand-red-dark", "font-semibold");
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    msg.classList.add("hidden");
    const email = emailInput.value.trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      showError("Please enter a valid email address.");
      return;
    }
    const supabase = getSupabase();
    if (!supabase) return;

    // Where to send them after they verify. Stored locally so the callback
    // does not depend on extra query params being allow-listed.
    const target = ownerInput.checked ? "/list-your-company" : "/account";
    try {
      localStorage.setItem("st_post_login_next", target);
    } catch {
      /* storage blocked; callback falls back to /account */
    }

    btn.disabled = true;
    btn.textContent = "Sending…";
    const redirectTo = `${location.origin}/auth/callback`;
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { emailRedirectTo: redirectTo },
    });
    if (error) {
      btn.disabled = false;
      btn.textContent = "Send me a sign-up link";
      const status = (error as { status?: number }).status;
      console.error("signup signInWithOtp error", status, error.message);
      showError(`Could not send the link. ${error.message}${status ? ` (status ${status})` : ""}.`);
      return;
    }
    form.hidden = true;
    sentTo.textContent = email;
    sent.hidden = false;
    sent.classList.remove("hidden");
  });
</script>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Sign up | SoCal Trades"
  description="Create a SoCal Trades account."
>
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-md px-4 py-12">
    <h1 class="text-3xl font-bold text-brand-blue">Sign up</h1>
    <p class="mt-3 text-lg text-gray-800">Create your account.</p>

    <form id="signup-form" class="mt-8 flex flex-col gap-5" novalidate>
      <div class="flex flex-col gap-2">
        <label class="text-lg font-semibold text-gray-800" for="signup-email">Email</label>
        <input
          id="signup-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue"
        />
      </div>
      <div class="flex flex-col gap-2">
        <label class="text-lg font-semibold text-gray-800" for="signup-password">
          Password
          <span class="font-normal text-base text-gray-600">(at least 8 characters)</span>
        </label>
        <input
          id="signup-password"
          name="password"
          type="password"
          required
          autocomplete="new-password"
          minlength="8"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue"
        />
      </div>
      <div class="flex flex-col gap-2">
        <label class="text-lg font-semibold text-gray-800" for="signup-confirm">Confirm password</label>
        <input
          id="signup-confirm"
          name="confirm"
          type="password"
          required
          autocomplete="new-password"
          class="tap-target rounded-lg border-2 border-gray-300 bg-white px-4 text-lg text-gray-900 focus:border-brand-blue"
        />
      </div>

      <label class="flex items-start gap-3 rounded-lg border-2 border-gray-300 bg-white p-4">
        <input id="is-owner" name="owner" type="checkbox" class="mt-1 h-6 w-6 shrink-0 accent-brand-blue" />
        <span class="text-lg text-gray-800">
          I own a business in the trades
          <span class="mt-1 block text-base text-gray-600">
            Use your company email (matching your website domain), not a personal
            one. We will take you to add your company after you sign up.
          </span>
        </span>
      </label>

      <button
        id="signup-btn"
        type="submit"
        class="tap-target rounded-lg bg-brand-blue px-6 text-lg font-semibold text-white hover:opacity-90"
      >
        Create account
      </button>
      <p id="signup-msg" class="hidden text-lg" role="alert"></p>

      <p class="text-lg text-gray-700">
        Already have an account? <a href="/login" class="text-brand-blue underline">Log in</a>.
      </p>
    </form>

    <div id="signup-confirm-email" class="mt-8 hidden rounded-xl border border-gray-200 bg-white p-6" hidden>
      <h2 class="text-2xl font-bold text-brand-blue">Confirm your email</h2>
      <p class="mt-3 text-lg text-gray-800">
        We sent a confirmation link to <span id="confirm-to" class="font-semibold"></span>.
        Open it to activate your account, then log in.
      </p>
    </div>

    <div id="signup-unavailable" class="mt-8 hidden rounded-xl border border-gray-200 bg-white p-6" hidden>
      <p class="text-lg text-gray-800">
        Sign up is not switched on yet. It goes live once the site is connected
        to its accounts service.
      </p>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { getSupabase, isConfigured, setAuthFlag } from "../lib/supabaseClient";
  import { isBusinessEmail } from "../lib/emailDomain";

  const form = document.getElementById("signup-form") as HTMLFormElement;
  const emailInput = document.getElementById("signup-email") as HTMLInputElement;
  const passwordInput = document.getElementById("signup-password") as HTMLInputElement;
  const confirmInput = document.getElementById("signup-confirm") as HTMLInputElement;
  const ownerInput = document.getElementById("is-owner") as HTMLInputElement;
  const btn = document.getElementById("signup-btn") as HTMLButtonElement;
  const msg = document.getElementById("signup-msg")!;
  const confirmEmailPanel = document.getElementById("signup-confirm-email")!;
  const confirmTo = document.getElementById("confirm-to")!;
  const unavailable = document.getElementById("signup-unavailable")!;

  if (!isConfigured()) {
    form.hidden = true;
    unavailable.hidden = false;
    unavailable.classList.remove("hidden");
  }

  function showError(text: string): void {
    msg.textContent = text;
    msg.classList.remove("hidden");
    msg.classList.add("text-brand-red-dark", "font-semibold");
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    msg.classList.add("hidden");
    const email = emailInput.value.trim();
    const password = passwordInput.value;
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      showError("Please enter a valid email address.");
      return;
    }
    if (password.length < 8) {
      showError("Password must be at least 8 characters.");
      return;
    }
    if (password !== confirmInput.value) {
      showError("The passwords do not match.");
      return;
    }
    // Business owners must use a company email (not a free/personal provider).
    if (ownerInput.checked && !isBusinessEmail(email)) {
      showError(
        "Business owners need to sign up with a company email that matches your website domain. If you only have a personal email, email us at hello@socaltrades.net and we will verify and add your business for you.",
      );
      return;
    }
    const supabase = getSupabase();
    if (!supabase) return;

    const target = ownerInput.checked ? "/list-your-company" : "/account";
    try {
      localStorage.setItem("st_post_login_next", target);
    } catch {
      /* storage blocked */
    }

    btn.disabled = true;
    btn.textContent = "Creating…";
    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: { emailRedirectTo: `${location.origin}/auth/callback` },
    });
    if (error) {
      btn.disabled = false;
      btn.textContent = "Create account";
      showError(error.message);
      return;
    }

    // If email confirmation is off, a session is returned and we are signed in.
    if (data.session) {
      setAuthFlag(data.user?.email ?? email);
      location.replace(target);
      return;
    }
    // Otherwise the user must confirm by email first.
    form.hidden = true;
    confirmTo.textContent = email;
    confirmEmailPanel.hidden = false;
    confirmEmailPanel.classList.remove("hidden");
  });
</script>
